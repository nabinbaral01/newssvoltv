# ---------------------------------------------------------------- database
# Local dev: `npm run db` starts an embedded Postgres 17 on this URL.
# Production: point at Neon / Supabase and keep sslmode=require.
#
# connection_limit matters at build time: `next build` prerenders with one
# worker per core, each holding its own Prisma pool. Left at the default those
# pools together exhaust Postgres's 100 connections and static generation
# starts failing. Serverless deployments want a pooled URL (pgbouncer) instead.
DATABASE_URL="postgresql://volt:volt@127.0.0.1:55432/voltv?connection_limit=5"

# ---------------------------------------------------------------- auth
# openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional — Google sign-in is hidden from the UI when these are unset.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------- analytics
# Salt for hashing visitor cookies and IP addresses. Rotating it anonymises
# all historical rows, which is the point. Never commit a real value.
ANALYTICS_SALT="replace-me-too"

# Secret required by /api/cron/* (rollups, scheduled publishing, retention).
CRON_SECRET="replace-me-as-well"

# ---------------------------------------------------------------- media
# "local" writes to public/uploads (dev default). "s3" uses the block below.
MEDIA_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ---------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------- email
# Password-reset and newsletter mail. Without a key, reset links are
# printed to the server console instead of sent, so the flow still works
# in development.
RESEND_API_KEY=""
EMAIL_FROM="Volt V <noreply@yourdomain.com>"

# "Thanks for signing in" notification. Throttled to one per account per
# window so it stays a security signal rather than inbox noise.
LOGIN_NOTIFICATION_EMAILS="true"
LOGIN_NOTIFICATION_HOURS="12"
