# ---------------------------------------------------------------- database
# Local dev: `npm run db` starts an embedded Postgres 17 on this URL.
# Production: point at Neon / Supabase and keep sslmode=require.
#
# connection_limit matters at build time: `next build` prerenders with one
# worker per core, each holding its own Prisma pool. Left at the default those
# pools together exhaust Postgres's 100 connections and static generation
# starts failing. Serverless deployments want a pooled URL (pgbouncer) instead.
# Deliberately blank. Vercel pre-fills environment variables from this file on
# import, so a working-looking localhost URL here ends up in production builds.
#
#   local dev:  postgresql://volt:volt@127.0.0.1:55432/voltv?connection_limit=5
#   production: your pooled Neon/Supabase URL, with sslmode=require
DATABASE_URL=""

# ---------------------------------------------------------------- auth
# openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional — Google sign-in is hidden from the UI when these are unset.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------- analytics
# Salt for hashing visitor cookies and IP addresses. Rotating it anonymises
# all historical rows, which is the point. Never commit a real value.
ANALYTICS_SALT="replace-me-too"

# Secret required by /api/cron/* (rollups, scheduled publishing, retention).
CRON_SECRET="replace-me-as-well"

# ---------------------------------------------------------------- media
# "local" writes to public/uploads (dev default). "s3" uses the block below.
MEDIA_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ---------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------- email
# Invitations, password resets and newsletter mail. With nothing set,
# messages are printed to the server console instead of sent, so every
# flow still works in development.
#
# SMTP wins over Resend when both are configured. Any SMTP server works;
# Gmail needs an app password (myaccount.google.com/apppasswords, which
# requires 2-Step Verification), NOT the account password.
#
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
#   SMTP_USER="you@gmail.com"
#   SMTP_PASS="abcd efgh ijkl mnop"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Resend. Note that the shared onboarding@resend.dev sender only delivers
# to the address that owns the Resend account — that is an anti-abuse rule,
# not a billing limit, and a paid plan does not lift it. To reach anyone
# else, verify a domain or use SMTP above.
RESEND_API_KEY=""
EMAIL_FROM="Volt V <noreply@yourdomain.com>"

# "Thanks for signing in" notification. Throttled to one per account per
# window so it stays a security signal rather than inbox noise.
LOGIN_NOTIFICATION_EMAILS="true"
LOGIN_NOTIFICATION_HOURS="12"
