# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Secrets never leave the machine. The example file is documentation and is
# committed deliberately — gitignore has no trailing comments, so the negation
# must sit on its own line.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# volt
.pgdata/
public/uploads/
test-results/
playwright-report/

.screenshots/
.backups/

# Generated by next dev on every run; local tooling notes, not project code.
AGENTS.md
CLAUDE.md
